# Maintainer: VolRen <VolRencs@proton.me>
pkgname=kleaner
pkgver=1.3.3
pkgrel=1
pkgdesc="Linux System Optimizer and Monitoring"
arch=('x86_64' 'aarch64')
url="https://volrencs.github.io/Kleaner/"
license=('GPL-3.0-only')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'kirigami'
    'kcoreaddons'
    'kconfig'
    'kdbusaddons'
    'kstatusnotifieritem'
    'kio'
    'kauth'
)
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'wayland-protocols')
optdepends=('breeze-icons: icon theme for the KDE desktop')
conflicts=('kleaner-git')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/VolRencs/Kleaner/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b2d2a4e0491dee5119ce5cc475fb73e264b8578d27c2f3bac4a5150644d7e6bc')

build() {
    cmake -S "Kleaner-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
