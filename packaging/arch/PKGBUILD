# Maintainer: Stacer fork maintainers
#
# Development PKGBUILD: builds the local checkout two directories above.
# When the fork is published, replace the build() source with the repository
# URL and drop the local-path handling, for example:
#   source=("$pkgname::git+https://example.org/stacer.git")
#   pkgver() { cd "$pkgname"; git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'; }

pkgname=stacer-git
pkgver=1.7.0
pkgrel=1
pkgdesc="Linux System Optimizer and Monitoring (Qt 6 / Kirigami rewrite)"
arch=('x86_64' 'aarch64')
url="https://github.com/QuentiumYT/Stacer"
license=('GPL-3.0-only')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'qt6-wayland'
    'kirigami'
    'kquickcharts'
    'kcoreaddons'
    'kconfig'
    'kdbusaddons'
    'kstatusnotifieritem'
    'kio'
    'kauth'
    'qqc2-desktop-style'
)
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
optdepends=('breeze-icons: icon theme for the KDE desktop')
provides=('stacer')
conflicts=('stacer' 'stacer-bin')
options=('!lto')

build() {
    cmake -S "$startdir/../.." -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
