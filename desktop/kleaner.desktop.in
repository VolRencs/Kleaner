[Desktop Entry]
Version=1.0
Type=Application
Name=Kleaner
GenericName=Linux System Optimizer and Monitoring
GenericName[fr]=Optimiseur et moniteur du système Linux
GenericName[ru]=Оптимизатор и монитор системы Linux
GenericName[uk]=Оптимізатор і монітор системи Linux
Comment=Optimize and monitor your Linux system
Comment[fr]=Optimisation et contrôle de votre système Linux
Comment[ru]=Оптимизация и контроль вашей системы Linux
Comment[uk]=Оптимізація та контроль вашої системи Linux
Icon=@KLEANER_APP_ID@
Exec=kleaner
DBusActivatable=true
Terminal=false
Categories=System;Monitor;
Keywords=optimize;monitor;system;services;processes;cleaner;
Keywords[ru]=оптимизация;монитор;система;службы;процессы;очистка;
Keywords[uk]=оптимізація;монітор;система;служби;процеси;очищення;
StartupNotify=true
StartupWMClass=@KLEANER_APP_ID@
