<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 VolRen -->
<component type="desktop-application">
    <id>@KLEANER_APP_ID@.desktop</id>

    <name>Kleaner</name>
    <summary>Linux System Optimizer and Monitoring</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-only</project_license>
    <content_rating type="oars-1.1"/>

    <developer id="org.volren">
        <name>VolRen</name>
    </developer>

    <description>
        <p>Kleaner is a system optimizer and monitor for Arch Linux. It shows live CPU, memory, disk and network usage, manages processes and systemd services, controls startup applications, cleans caches and logs, and edits /etc/hosts.</p>
        <p>Built with Qt 6 and KDE Frameworks 6, it runs as a native Wayland application with a dark interface. Kleaner is a fork of Stacer.</p>
    </description>

    <launchable type="desktop-id">@KLEANER_APP_ID@.desktop</launchable>

    <icon type="stock">@KLEANER_APP_ID@</icon>

    <branding>
        <color type="primary" scheme_preference="light">#1a7fb5</color>
        <color type="primary" scheme_preference="dark">#3daee9</color>
    </branding>

    <categories>
        <category>System</category>
        <category>Monitor</category>
    </categories>

    <keywords>
        <keyword>optimize</keyword>
        <keyword>monitor</keyword>
        <keyword>services</keyword>
    </keywords>

    <url type="homepage">https://volrencs.github.io/Kleaner/</url>
    <url type="bugtracker">https://github.com/VolRencs/Kleaner/issues</url>
    <url type="vcs-browser">https://github.com/VolRencs/Kleaner</url>

    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/VolRencs/Kleaner/v1.1.0/docs/screenshots/dashboard.png</image>
            <caption>Dashboard with live system overview</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/VolRencs/Kleaner/v1.1.0/docs/screenshots/processes.png</image>
            <caption>Process list with sorting and filtering</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/VolRencs/Kleaner/v1.1.0/docs/screenshots/cleaner.png</image>
            <caption>System cleaner</caption>
        </screenshot>
    </screenshots>

    <provides>
        <binary>kleaner</binary>
    </provides>

    <releases>
        <release version="1.2.2" date="2026-09-14">
            <description>
                <p>Fixed the system cleaner getting stuck on "Cleaning…" when several user-owned paths, such as application caches, were selected at once.</p>
            </description>
        </release>
        <release version="1.2.1" date="2026-09-14">
            <description>
                <p>English can now be selected explicitly in the language selector; it is the source language and previously was only reachable through the system locale fallback.</p>
            </description>
        </release>
        <release version="1.2.0" date="2026-09-14">
            <description>
                <p>Disk I/O and network monitoring now report real values, the hosts editor and the privileged cleaner are safer, and user cleanup no longer freezes the window. The interface received KDE-style rounded list highlighting, spinning refresh buttons, a more compact resource legend and unique colours for CPU cores.</p>
            </description>
        </release>
        <release version="1.1.0" date="2026-09-14">
            <description>
                <p>Resources now show per-core CPU history on a single translucent chart with live statistics and hover highlighting. The system cleaner performs the whole privileged cleanup with one authentication prompt, includes temporary files and vacuums the journal completely, and reports the exact freed size. Language and close-behaviour selectors, the tray menu and launching from the application menu were fixed.</p>
            </description>
        </release>
        <release version="1.0.0" date="2026-09-14">
            <description>
                <p>First release of Kleaner: a complete rewrite of the Stacer interface on Qt 6 and KDE Frameworks 6 with a modern dark UI, service management, startup entries, a system cleaner with pacman/journal support and full Russian and Ukrainian translations.</p>
            </description>
        </release>
    </releases>
</component>
